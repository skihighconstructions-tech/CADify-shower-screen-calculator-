rules_version = '2';

// ============================================================
// CADify — Firestore security rules
// The isolation guarantee: every account can read/write ONLY its
// own /users/{uid} subtree. Enforced by Google's servers on every
// request, so one subscriber can never see another's clients/jobs.
// ============================================================
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }
    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }
    // Stripe (Firebase extension) writes a custom claim `stripeRole`
    // on accounts with an active/trialing subscription.
    function hasActiveSub() {
      return signedIn()
        && request.auth.token.stripeRole != null
        && request.auth.token.stripeRole in ['active', 'trialing', 'basic', 'pro'];
    }

    // ---- All account data lives here, isolated per user ----
    match /users/{uid} {
      // reading your own profile is fine once signed in
      allow read: if isOwner(uid);
      allow write: if isOwner(uid);

      // clients, jobs, results, settings — everything under the account.
      // READ: must own it.  WRITE: must own it AND have an active sub.
      // (During development, drop `&& hasActiveSub()` to build without billing.)
      match /{document=**} {
        allow read:  if isOwner(uid);
        allow write: if isOwner(uid) && hasActiveSub();
      }
    }

    // ---- Stripe extension customer + subscription docs (read-only to owner) ----
    match /customers/{uid} {
      allow read: if isOwner(uid);
      match /checkout_sessions/{id} {
        allow read, write: if isOwner(uid);   // extension needs client to create sessions
      }
      match /subscriptions/{id} { allow read: if isOwner(uid); }
      match /payments/{id}      { allow read: if isOwner(uid); }
    }

    // Public product/price catalogue written by the Stripe extension
    match /products/{id} {
      allow read: if true;
      match /prices/{id}  { allow read: if true; }
      match /tax_rates/{id} { allow read: if true; }
    }
  }
}
